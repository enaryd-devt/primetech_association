<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_association_settings_form" model="ir.ui.view">
        <field name="name">association.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="arch" type="xml">

            <form string="Paramètres">

                <sheet>

                    <div class="oe_title">
                        <h1>PrimeTech Association</h1>
                    </div>

                </sheet>

            </form>

        </field>
    </record>

    <record id="action_association_settings"
            model="ir.actions.act_window">

        <field name="name">Paramètres</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>

    </record>

</odoo>