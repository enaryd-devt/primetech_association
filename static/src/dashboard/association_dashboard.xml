<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="primetech_association.AssociationDashboard">
    <div class="o_association_dashboard">
      <t t-if="state.loading"><div class="o_dashboard_loading"><i class="fa fa-circle-o-notch fa-spin"/><span>Chargement du tableau de bord…</span></div></t>
      <t t-else="">
        <header class="dash_head">
          <div><h1>Bonjour, <t t-esc="state.data.user_name || 'Administrateur'"/> <span>👋</span></h1><p>Tableau de bord de l'association</p></div>
          <div class="dash_head_actions">
            <span class="dash_filter"><i class="fa fa-calendar-o"/> <t t-esc="todayLabel()"/></span>
            <span class="dash_filter"><i class="fa fa-link"/> Toutes les sections <i class="fa fa-angle-down"/></span>
            <div class="dash_org"><span class="dash_logo"><i class="fa fa-users"/></span><span><strong t-esc="state.data.company.name"/><small>Vue générale</small></span></div>
            <button class="dash_refresh" title="Actualiser" t-on-click="loadDashboard"><i class="fa fa-refresh"/></button>
          </div>
        </header>

        <section class="kpi_grid">
          <t t-foreach="kpis" t-as="kpi" t-key="kpi.label">
            <article class="kpi_card"><span t-att-class="'kpi_icon ' + kpi.color"><i t-att-class="'fa ' + kpi.icon"/></span><div><small t-esc="kpi.label"/><strong><t t-esc="kpi.value"/><em t-if="kpi.currency" t-esc="state.data.currency.symbol"/></strong><span t-att-class="kpi.negative ? 'trend down' : 'trend'"><i t-att-class="kpi.negative ? 'fa fa-arrow-down' : 'fa fa-arrow-up'"/> <t t-esc="kpi.note"/></span></div></article>
          </t>
        </section>

        <section class="dash_grid top_grid">
          <article class="dash_panel members_panel"><div class="panel_title"><h2>Répartition des membres</h2><span>Toutes les sections <i class="fa fa-angle-down"/></span></div>
            <div class="donut_wrap"><div class="donut members_donut"><div><strong t-esc="state.data.members.total || 0"/><small>Total</small></div></div>
              <ul class="legend"><li><i class="blue"/> Membres actifs <b><t t-esc="memberPercent"/>%</b></li><li><i class="green"/> Autres membres <b><t t-esc="100-memberPercent"/>%</b></li><li><i class="orange"/> Cotisations en attente <b t-esc="state.data.subscriptions.pending || 0"/></li><li><i class="purple"/> Présents dernière réunion <b t-esc="state.data.meetings.last_attendance || 0"/></li></ul>
            </div>
          </article>
          <article class="dash_panel chart_panel"><div class="panel_title"><h2>Évolution des cotisations</h2><span>6 derniers mois <i class="fa fa-angle-down"/></span></div><div class="chart_key"><i class="blue"/> Montant collecté <i class="green"/> Nombre de cotisations</div>
            <div class="bar_chart"><div class="grid_lines"/><t t-foreach="chartBars" t-as="bar" t-key="bar.month"><div class="bar_col"><div class="bar" t-att-style="'height:' + bar.height + '%'"/><span t-esc="bar.month"/></div></t><svg viewBox="0 0 600 180" preserveAspectRatio="none"><polyline points="20,125 130,55 245,105 360,120 475,35 585,105"/></svg></div>
          </article>
          <article class="dash_panel"><div class="panel_title"><h2>Prochains événements</h2><button t-on-click="openMeetings">Voir tout</button></div><div class="event_list"><t t-if="state.data.upcoming_meetings.length"><t t-foreach="state.data.upcoming_meetings" t-as="meeting" t-key="meeting.id"><div class="event_row" t-on-click="() => this.openMeeting(meeting.id)"><span class="event_icon"><i class="fa fa-calendar"/></span><div><strong t-esc="meeting.title"/><small><t t-esc="meeting.date"/> <i class="fa fa-circle"/> <t t-esc="meeting.time || 'À confirmer'"/></small></div><em>À venir</em></div></t></t><t t-else=""><div class="empty">Aucun événement programmé</div></t></div></article>
        </section>

        <section class="dash_grid middle_grid">
          <article class="dash_panel"><div class="panel_title"><h2>Situation financière</h2><span>Ce mois <i class="fa fa-angle-down"/></span></div><div class="finance_values"><div><i class="fa fa-money green_text"/><small>Total encaissé</small><strong><t t-esc="formatAmount(state.data.payments.total)"/> <em t-esc="state.data.currency.symbol"/></strong></div><div><i class="fa fa-line-chart red_text"/><small>Cotisations dues</small><strong t-esc="state.data.subscriptions.pending || 0"/></div><div><i class="fa fa-balance-scale blue_text"/><small>Solde disponible</small><strong><t t-esc="formatAmount(state.data.treasury.balance)"/> <em t-esc="state.data.currency.symbol"/></strong></div></div><div class="progress_label"><span>Encaissements confirmés</span><b>68%</b></div><div class="progress"><i style="width:68%"/></div><div class="progress_label"><span>Participation membres</span><b t-esc="memberPercent + '%'"/></div><div class="progress red"><i t-att-style="'width:' + memberPercent + '%'"/></div></article>
          <article class="dash_panel"><div class="panel_title"><h2>Répartition des activités</h2><span>Ce mois <i class="fa fa-angle-down"/></span></div><div class="donut_wrap"><div class="donut expense_donut"><div><strong t-esc="formatAmount(state.data.treasury.balance)"/><small t-esc="state.data.currency.symbol"/></div></div><ul class="legend"><li><i class="blue"/> Cotisations <b>40%</b></li><li><i class="green"/> Réunions <b>25%</b></li><li><i class="orange"/> Dons et entraide <b>15%</b></li><li><i class="purple"/> Événements <b>10%</b></li><li><i class="slate"/> Administration <b>10%</b></li></ul></div></article>
          <article class="dash_panel penalty_panel"><div class="panel_title"><h2>Pénalités &amp; discipline</h2><button t-on-click="openPenalties">Voir tout</button></div><div class="penalty_summary"><div><span class="penalty_icon"><i class="fa fa-gavel"/></span><small>Sanctions à traiter</small><strong t-esc="state.data.penalties.pending || 0"/></div><div><span class="penalty_icon money"><i class="fa fa-money"/></span><small>Reste à recouvrer</small><strong><t t-esc="formatAmount(state.data.penalties.amount_remaining)"/> <em t-esc="state.data.currency.symbol"/></strong></div></div><div class="penalty_recent"><t t-if="state.data.penalties.recent.length"><t t-foreach="state.data.penalties.recent.slice(0, 2)" t-as="penalty" t-key="penalty.id"><button t-on-click="() => this.openPenalty(penalty.id)"><span><strong t-esc="penalty.member"/><small><t t-esc="penalty.type"/> · <t t-esc="penalty.date"/></small></span><em t-att-class="'penalty_state ' + penalty.state_code" t-esc="penalty.state"/></button></t></t><t t-else=""><div class="empty">Aucune pénalité enregistrée</div></t></div></article>
        </section>

        <section class="dash_grid bottom_grid">
          <article class="dash_panel"><div class="panel_title"><h2>Membres récemment inscrits</h2><button t-on-click="openMembers">Voir tout</button></div><div class="table"><div class="tr th"><span>Nom</span><span>Statut</span><span>Date d'inscription</span></div><t t-foreach="state.data.recent_members" t-as="member" t-key="member.id"><div class="tr"><span class="person"><i class="fa fa-user-circle"/> <t t-esc="member.name"/></span><span class="badge" t-esc="member.state"/><span t-esc="member.date"/></div></t><div t-if="!state.data.recent_members.length" class="empty">Aucun membre récent</div></div></article>
          <article class="dash_panel"><div class="panel_title"><h2>Encaissements récents</h2><button t-on-click="openPayments">Voir tout</button></div><div class="table"><div class="tr th"><span>Membre</span><span>Montant</span><span>Date</span></div><t t-foreach="state.data.recent_payments" t-as="payment" t-key="payment.id"><div class="tr"><span t-esc="payment.member || payment.name"/><span><b t-esc="formatAmount(payment.amount)"/> <small t-esc="state.data.currency.symbol"/></span><span t-esc="payment.date"/></div></t><div t-if="!state.data.recent_payments.length" class="empty">Aucun encaissement récent</div></div></article>
          <article class="dash_panel sections"><div class="panel_title"><h2>Répartition par indicateur</h2><button t-on-click="openMembers">Voir plus</button></div><t t-foreach="sections" t-as="section" t-key="section.name"><div class="section_bar"><span t-esc="section.name"/><i><b t-att-style="'width:' + section.value + '%'"/></i><em t-esc="section.value + '%'"/></div></t></article>
          <article class="dash_panel alerts"><div class="panel_title"><h2>Alertes &amp; notifications</h2></div><div t-on-click="openPenalties" class="clickable"><i class="fa fa-gavel"/><span><strong>Pénalités à traiter</strong><small><t t-esc="state.data.penalties.pending || 0"/> sanctions nécessitent un suivi.</small></span></div><div><i class="fa fa-calendar-times-o orange_text"/><span><strong>Réunions à préparer</strong><small><t t-esc="state.data.meetings.upcoming || 0"/> réunions prochainement.</small></span></div><div><i class="fa fa-info-circle blue_text"/><span><strong>Registre des membres</strong><small><t t-esc="state.data.members.total || 0"/> fiches membres enregistrées.</small></span></div></article>
        </section>
        <footer><span>© 2026 <t t-esc="state.data.company.name"/>. Tous droits réservés.</span><span>Tableau de bord mis à jour aujourd'hui <button t-on-click="loadDashboard"><i class="fa fa-refresh"/></button></span><span>Développé avec <b>♥</b> pour votre impact positif</span></footer>
      </t>
    </div>
  </t>
</templates>
