<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">

    <t
        t-name="primetech_association.AssociationDashboard">

        <div class="o_association_dashboard">

            <!-- ============================================== -->
            <!-- CHARGEMENT                                     -->
            <!-- ============================================== -->

            <t t-if="state.loading">

                <div class="o_dashboard_loading">

                    <i class="fa fa-spinner fa-spin"/>

                    <span>
                        Chargement du tableau de bord...
                    </span>

                </div>

            </t>


            <!-- ============================================== -->
            <!-- DASHBOARD                                      -->
            <!-- ============================================== -->

            <t t-else="">

                <!-- ========================================== -->
                <!-- ENTÊTE                                     -->
                <!-- ========================================== -->

                <div class="o_dashboard_header">

                    <div>

                        <h1>
                            Tableau de bord
                        </h1>

                        <p>

                            Vue d'ensemble de

                            <strong>
                                <t
                                    t-esc="
                                        state.data.company.name
                                    "
                                />
                            </strong>

                        </p>

                    </div>


                    <button
                        class="btn btn-light"
                        t-on-click="loadDashboard">

                        <i class="fa fa-refresh me-2"/>

                        Actualiser

                    </button>

                </div>


                <!-- ========================================== -->
                <!-- STATISTIQUES                               -->
                <!-- ========================================== -->

                <div class="o_dashboard_stats">

                    <div class="o_dashboard_stat">

                        <div class="o_stat_icon">

                            <i class="fa fa-users"/>

                        </div>

                        <div>

                            <span class="o_stat_value">

                                <t
                                    t-esc="
                                        state.data.members.active
                                        || 0
                                    "
                                />

                            </span>

                            <span class="o_stat_label">

                                Membres actifs

                            </span>

                        </div>

                    </div>


                    <div class="o_dashboard_stat">

                        <div class="o_stat_icon">

                            <i class="fa fa-check-square-o"/>

                        </div>

                        <div>

                            <span class="o_stat_value">

                                <t
                                    t-esc="
                                        state.data.meetings
                                            .last_attendance
                                        || 0
                                    "
                                />

                            </span>

                            <span class="o_stat_label">

                                Dernière présence

                            </span>

                        </div>

                    </div>


                    <div class="o_dashboard_stat">

                        <div class="o_stat_icon">

                            <i class="fa fa-university"/>

                        </div>

                        <div>

                            <span class="o_stat_value">

                                <t
                                    t-esc="
                                        formatAmount(
                                            state.data.treasury
                                                .balance
                                        )
                                    "
                                />

                                <small>

                                    <t
                                        t-esc="
                                            state.data.currency
                                                .symbol
                                        "
                                    />

                                </small>

                            </span>

                            <span class="o_stat_label">

                                Trésorerie

                            </span>

                        </div>

                    </div>


                    <div class="o_dashboard_stat">

                        <div class="o_stat_icon">

                            <i class="fa fa-calendar"/>

                        </div>

                        <div>

                            <span class="o_stat_value">

                                <t
                                    t-esc="
                                        state.data.meetings
                                            .upcoming
                                        || 0
                                    "
                                />

                            </span>

                            <span class="o_stat_label">

                                Réunions à venir

                            </span>

                        </div>

                    </div>

                </div>


                <!-- ========================================== -->
                <!-- TITRE MENUS                                -->
                <!-- ========================================== -->

                <div class="o_dashboard_section_title">

                    <h2>
                        Gestion de l'association
                    </h2>

                    <p>
                        Accès rapide aux principales opérations
                    </p>

                </div>


                <!-- ========================================== -->
                <!-- MENUS                                      -->
                <!-- ========================================== -->

                <div class="o_dashboard_menu_grid">


                    <!-- MEMBRES -->

                    <div
                        class="o_dashboard_menu_card"
                        t-on-click="openMembers">

                        <div class="o_menu_icon">

                            <i class="fa fa-users"/>

                        </div>

                        <div class="o_menu_content">

                            <h3>
                                Membres
                            </h3>

                            <p>
                                Gestion des adhérents
                                et informations membres.
                            </p>

                            <span class="o_menu_stat">

                                <t
                                    t-esc="
                                        state.data.members.total
                                        || 0
                                    "
                                />

                                membres

                            </span>

                        </div>

                        <i class="fa fa-chevron-right o_menu_arrow"/>

                    </div>


                    <!-- RÉUNIONS -->

                    <div
                        class="o_dashboard_menu_card"
                        t-on-click="openMeetings">

                        <div class="o_menu_icon">

                            <i class="fa fa-calendar"/>

                        </div>

                        <div class="o_menu_content">

                            <h3>
                                Réunions
                            </h3>

                            <p>
                                Organisation des séances,
                                présences et procès-verbaux.
                            </p>

                            <span class="o_menu_stat">

                                <t
                                    t-esc="
                                        state.data.meetings
                                            .upcoming
                                        || 0
                                    "
                                />

                                à venir

                            </span>

                        </div>

                        <i class="fa fa-chevron-right o_menu_arrow"/>

                    </div>


                    <!-- COTISATIONS -->

                    <div
                        class="o_dashboard_menu_card"
                        t-on-click="openSubscriptions">

                        <div class="o_menu_icon">

                            <i class="fa fa-money"/>

                        </div>

                        <div class="o_menu_content">

                            <h3>
                                Cotisations
                            </h3>

                            <p>
                                Suivi des cotisations
                                et règlements membres.
                            </p>

                            <span class="o_menu_stat">

                                <t
                                    t-esc="
                                        state.data.subscriptions
                                            .pending
                                        || 0
                                    "
                                />

                                en attente

                            </span>

                        </div>

                        <i class="fa fa-chevron-right o_menu_arrow"/>

                    </div>


                    <!-- ENCAISSEMENTS -->

                    <div
                        class="o_dashboard_menu_card"
                        t-on-click="openPayments">

                        <div class="o_menu_icon">

                            <i class="fa fa-credit-card"/>

                        </div>

                        <div class="o_menu_content">

                            <h3>
                                Encaissements
                            </h3>

                            <p>
                                Paiements, affectations
                                et règlements.
                            </p>

                            <span class="o_menu_stat">

                                <t
                                    t-esc="
                                        formatAmount(
                                            state.data.payments.total
                                        )
                                    "
                                />

                                <t
                                    t-esc="
                                        state.data.currency.symbol
                                    "
                                />

                            </span>

                        </div>

                        <i class="fa fa-chevron-right o_menu_arrow"/>

                    </div>


                    <!-- TRÉSORERIE -->

                    <div
                        class="o_dashboard_menu_card"
                        t-on-click="openTreasury">

                        <div class="o_menu_icon">

                            <i class="fa fa-university"/>

                        </div>

                        <div class="o_menu_content">

                            <h3>
                                Trésorerie
                            </h3>

                            <p>
                                Comptes financiers
                                et mouvements de trésorerie.
                            </p>

                            <span class="o_menu_stat">

                                <t
                                    t-esc="
                                        formatAmount(
                                            state.data.treasury
                                                .balance
                                        )
                                    "
                                />

                                <t
                                    t-esc="
                                        state.data.currency.symbol
                                    "
                                />

                            </span>

                        </div>

                        <i class="fa fa-chevron-right o_menu_arrow"/>

                    </div>


                    <!-- DISCIPLINE -->

                    <div
                        class="o_dashboard_menu_card"
                        t-on-click="openPenalties">

                        <div class="o_menu_icon">

                            <i class="fa fa-gavel"/>

                        </div>

                        <div class="o_menu_content">

                            <h3>
                                Discipline
                            </h3>

                            <p>
                                Incidents, sanctions
                                et décisions disciplinaires.
                            </p>

                            <span class="o_menu_stat">

                                <t
                                    t-esc="
                                        state.data.penalties.pending
                                        || 0
                                    "
                                />

                                à traiter

                            </span>

                        </div>

                        <i class="fa fa-chevron-right o_menu_arrow"/>

                    </div>

                </div>


                <!-- ========================================== -->
                <!-- BAS DU DASHBOARD                           -->
                <!-- ========================================== -->

                <div class="o_dashboard_bottom">


                    <!-- DERNIERS ENCAISSEMENTS -->

                    <div class="o_dashboard_panel">

                        <div class="o_panel_header">

                            <div>

                                <h3>
                                    Derniers encaissements
                                </h3>

                                <p>
                                    Activité financière récente
                                </p>

                            </div>

                            <button
                                class="btn btn-link"
                                t-on-click="openPayments">

                                Voir tout

                            </button>

                        </div>


                        <div class="o_recent_payments">

                            <t
                                t-if="
                                    state.data.recent_payments.length
                                ">

                                <t
                                    t-foreach="
                                        state.data.recent_payments
                                    "
                                    t-as="payment"
                                    t-key="payment.id">

                                    <div class="o_payment_row">

                                        <div>

                                            <strong>
                                                <t
                                                    t-esc="
                                                        payment.member
                                                    "
                                                />
                                            </strong>

                                            <span>
                                                <t
                                                    t-esc="
                                                        payment.name
                                                    "
                                                />
                                            </span>

                                        </div>

                                        <div class="o_payment_amount">

                                            <strong>

                                                <t
                                                    t-esc="
                                                        formatAmount(
                                                            payment.amount
                                                        )
                                                    "
                                                />

                                                <t
                                                    t-esc="
                                                        state.data.currency
                                                            .symbol
                                                    "
                                                />

                                            </strong>

                                            <span>
                                                <t
                                                    t-esc="
                                                        payment.date
                                                    "
                                                />
                                            </span>

                                        </div>

                                    </div>

                                </t>

                            </t>


                            <t t-else="">

                                <div class="o_dashboard_empty">

                                    Aucun encaissement récent.

                                </div>

                            </t>

                        </div>

                    </div>


                    <!-- PROCHAINE RÉUNION -->

                    <div class="o_dashboard_panel">

                        <div class="o_panel_header">

                            <div>

                                <h3>
                                    Prochaine réunion
                                </h3>

                                <p>
                                    Prochaine séance programmée
                                </p>

                            </div>

                        </div>


                        <t t-if="state.data.next_meeting">

                            <div class="o_next_meeting">

                                <div class="o_meeting_calendar">

                                    <i class="fa fa-calendar"/>

                                </div>

                                <h3>

                                    <t
                                        t-esc="
                                            state.data.next_meeting.name
                                        "
                                    />

                                </h3>

                                <p>

                                    <i class="fa fa-clock-o me-2"/>

                                    <t
                                        t-esc="
                                            state.data.next_meeting.date
                                        "
                                    />

                                </p>

                                <t
                                    t-if="
                                        state.data.next_meeting.location
                                    ">

                                    <p>

                                        <i class="fa fa-map-marker me-2"/>

                                        <t
                                            t-esc="
                                                state.data.next_meeting
                                                    .location
                                            "
                                        />

                                    </p>

                                </t>


                                <button
                                    class="btn btn-primary"
                                    t-on-click="
                                        () =>
                                        this.openMeeting(
                                            state.data.next_meeting.id
                                        )
                                    ">

                                    Ouvrir la réunion

                                </button>

                            </div>

                        </t>


                        <t t-else="">

                            <div class="o_dashboard_empty">

                                Aucune réunion programmée.

                            </div>

                        </t>

                    </div>

                </div>

            </t>

        </div>

    </t>

</templates>